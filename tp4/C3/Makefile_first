CC = gcc
CFLAGS = -Wall -Wextra -g
LDLIBS = -lm

TARGET = prog

SRC = tests_vecteur.c \
	vecteur.c \
	teZZt.c

OBJ = $(SRC:.c=.o)

$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $(TARGET) $(LDLIBS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ)

fclean: clean
	rm -f $(TARGET)

re: fclean $(TARGET)